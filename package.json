{
  "name": "ens-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "abi:sync": "node scripts/sync-abi.mjs",
    "bootstrap:community": "node scripts/bootstrap-community.mjs",
    "build": "vite build",
    "check:chain": "node scripts/check-chain.mjs",
    "check:approval-sha": "node scripts/check-approval-sha.mjs",
    "check:dist-secrets": "node scripts/check-dist-secrets.mjs",
    "check:deploy-order": "node scripts/check-deploy-order.mjs",
    "check:ensv2-citations": "node scripts/check-ensv2-citations.mjs",
    "probe:ensv2-eac": "node scripts/ensv2-eac-revocation-probe.mjs",
    "check:ensv2": "node scripts/check-ensv2-resolution.mjs",
    "check:typecheck-scope": "node scripts/check-typecheck-scope.mjs",
    "check:skipped": "node scripts/check-skipped.mjs",
    "delegate": "node scripts/delegate.mjs",
    "dev": "vite",
    "docs:ens": "bash scripts/sync-ens-docs.sh",
    "preflight": "node scripts/preflight.mjs",
    "preview": "vite preview",
    "rotate:gateway-signer": "node scripts/rotate-gateway-signer.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.37.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^5.7.3",
    "undici": "^7.24.6",
    "vite": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
