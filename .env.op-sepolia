# ─── CometENS — Optimism Sepolia Testnet Configuration ────────────────────────
# Copy to .env.local and fill in values.

# ── Network ────────────────────────────────────────────────────────────────────
VITE_NETWORK=op-sepolia            # op-sepolia | op-mainnet

# ── Root domain ────────────────────────────────────────────────────────────────
# The ENS root domain managed by this instance. Subdomains are registered under it.
VITE_ROOT_DOMAIN=                  # e.g. aastar.eth

# ── Contracts ──────────────────────────────────────────────────────────────────
# ⚠️ Source of truth for the ADDRESSES THE DEPLOYED WORKERS USE is
#    workers/api/wrangler.toml and workers/gateway/wrangler.toml — not this file.
#    A local .env can drift from what is actually live; if the two disagree, the
#    Workers win. `pnpm check:chain` reads wrangler.toml on purpose for that reason.
#    The values below are for YOUR OWN deployment / local tooling.
VITE_L2_RECORDS_ADDRESS=           # L2Records on OP Sepolia
VITE_L1_OFFCHAIN_RESOLVER_ADDRESS= # OffchainResolver on Ethereum Sepolia
VITE_EIP712_VERIFYING_CONTRACT=    # Same as L2Records (EIP-712 domain)

# Server-side only (not bundled into browser)
OP_L2_RECORDS_ADDRESS=             # Same as VITE_L2_RECORDS_ADDRESS
L1_OFFCHAIN_RESOLVER_ADDRESS=      # Same as VITE_L1_OFFCHAIN_RESOLVER_ADDRESS

# ── Gateway ────────────────────────────────────────────────────────────────────
VITE_GATEWAY_URL=http://localhost:4173/api/ccip   # Local dev; prod: https://ens.aastar.io/api/ccip
GATEWAY_URL=http://localhost:4173/api/ccip

# ── RPC endpoints ─────────────────────────────────────────────────────────────
# Client-side (bundled — use public or paid RPC with CORS support)
VITE_L2_RPC_URL=                   # Optimism Sepolia RPC
VITE_L1_SEPOLIA_RPC_URL=           # Ethereum Sepolia RPC (used when VITE_NETWORK=op-sepolia)
VITE_L1_MAINNET_RPC_URL=           # Ethereum Mainnet RPC (used when VITE_NETWORK=op-mainnet)

# Server-side only
# Leave OP_SEPOLIA_RPC_URL blank to use the public endpoint https://sepolia.optimism.io
# (no API key, no per-app network enablement). Set it only if you have a paid RPC.
# Known trap: an Alchemy app that has not enabled the OPT_SEPOLIA network returns
# HTTP 403 on every call, and the error surfaces deep inside unrelated scripts.
# Run `pnpm check:chain` after changing this — it fails loudly instead of silently.
OP_SEPOLIA_RPC_URL=                # Optimism Sepolia RPC (blank = public endpoint)
SEPOLIA_RPC_URL=                   # Ethereum Sepolia RPC (integration tests)

# ── Signing keys (server-side only — NEVER expose with VITE_ prefix) ──────────
PRIVATE_KEY_SUPPLIER=              # Signs CCIP-Read gateway responses
WORKER_EOA_PRIVATE_KEY=            # Executes L2 write transactions
PRIVATE_KEY_JASON=                 # Deployer / test wallet

# ── Upstream allowed signers (machine-to-machine, POST /api/v1/register) ────────
# Comma-separated list of Ethereum addresses whose signatures are accepted.
# Each upstream app owns a keypair; add its address here to grant access.
# Remove an address to revoke access immediately.
# Example: UPSTREAM_ALLOWED_SIGNERS=0xABC...,0xDEF...
UPSTREAM_ALLOWED_SIGNERS=          # Required to enable /api/v1 endpoints

# ── Deployer addresses (for forge scripts) ────────────────────────────────────
DEPLOYER_ADDRESS=
SIGNER_ADDRESS=
ADDRESS_JASON_EOA=

# ─── Signing keys — three roles, three keys ──────────────────────────────────
#
# One key doing all three means a single leak both forges resolution responses AND seizes
# subdomains. Set exactly ONE name per role: setting both a new and a legacy name with
# DIFFERENT keys makes the workers refuse to start (which name wins changed with the rename,
# so deploying would silently swap the signer).
#
# `pnpm preflight` check 3b reports whether separation was actually achieved.

WRITER_KEY=            # executes L2 write transactions      (legacy: WORKER_EOA_PRIVATE_KEY)
GATEWAY_SIGNER_KEY=    # signs CCIP-Read gateway responses   (legacy: PRIVATE_KEY_SUPPLIER)
OWNER_KEY=             # contract owner / deployer — keep cold, off the routine write path
                       #                                     (legacy: PRIVATE_KEY_JASON)

# Delegated deployments hold other communities' names: make a shared key a hard failure
# rather than a warning.
# PREFLIGHT_KEY_SEPARATION=strict
